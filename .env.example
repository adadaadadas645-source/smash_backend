# Kopyala: cp .env.example .env  (.env repoya girmez)

NODE_ENV=development
PORT=4000
# LOG_LEVEL=debug

# ── Firebase: Avenia'nın veritabanı (aveniaapp). Avenia'nın Render'ındaki FIREBASE_SERVICE_ACCOUNT_KEY'in aynısı, TEK SATIR ──
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=aveniaapp
# Tüm koleksiyonların ön eki: kingdom_players, kingdom_leaderboard, kingdom_purchases, kingdom_logs
COLLECTION_PREFIX=kingdom_

# ── Kimlik (her biri için: openssl rand -hex 32) ──
JWT_SECRET=
JWT_TTL_DAYS=30
DEVICE_SECRET_PEPPER=

# ── Destek uçları (/api/v1/admin/*) için x-admin-key. Boş: kapalı ──
ADMIN_API_KEY=

# ── Google Play ──
ANDROID_PACKAGE_NAME=com.puzzle.blockescape
# Play Console > Para kazanma ayarları > Lisanslama: Base64 RSA ortak anahtarı (tek satır)
GOOGLE_PLAY_LICENSE_KEY=
# Play Developer API için ayrı servis hesabı (boşsa FIREBASE_SERVICE_ACCOUNT_KEY kullanılır)
# GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
# Lisans test hesaplarının satın almaları ödül alsın mı (kapalı test için true)
ALLOW_TEST_PURCHASES=true

# ── Dünya sıralaması ──
LEADERBOARD_MAX_LEVEL=5000
LEADERBOARD_TOP_LIMIT=100
LEADERBOARD_CACHE_SECONDS=30

# ── Firestore'a istek logu (kingdom_logs) ──
LOG_REQUESTS_TO_DB=true
LOG_RETENTION_DAYS=30
