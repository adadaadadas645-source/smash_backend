{
  "name": "kingdom-backend",
  "version": "1.0.0",
  "description": "Kingdom Smash: Cannon Blast backend (players, purchase verification, world leaderboard, logs)",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "test:e2e": "tsc -p tsconfig.test.json && node dist-test/test/e2e.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.16.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "pino-pretty": "^10.2.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "license": "UNLICENSED"
}
